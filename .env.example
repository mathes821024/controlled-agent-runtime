# Copy to .env locally if you want overrides. Never commit .env.
# This file contains no secrets and assumes no host password.

# Bind. Keep loopback unless a same-host reverse proxy needs otherwise.
CAR_DEMO_HOST=127.0.0.1
CAR_DEMO_PORT=8000

# Proposal hook: off | local_model
# Default off: canned seeds only. No model. No download.
# local_model is reserved and fail-closed until a later reviewed gate.
CAR_PROPOSAL_HOOK=off
